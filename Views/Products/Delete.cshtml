@model Lab9.Models.Product
@{ ViewData["Title"] = "Delete product"; }
<h1>Delete product</h1>
<div class="alert alert-warning">Are you sure you want to delete <strong>@Model.Name</strong>?</div>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Price.ToString("C")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
